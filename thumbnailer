#!/bin/bash
CACHE=~/.cache/playback
EXT=png

HASH=$(echo -n "$1" | sha256sum | awk '{print $1}')
INDEX=$(echo "$HASH" | cut -c-2)
mkdir -p "$CACHE"/$INDEX
NEW="$CACHE"/$INDEX/$HASH.new.$EXT
THUMB="$CACHE"/$INDEX/$HASH.$EXT

if [ ! -e "$THUMB" ] || [ "$1" -nt "$THUMB" ]; then
	if ! convert "$1"'[0]' -thumbnail x720 +profile "*" -flatten "$NEW" ; then
		rm -f "$NEW"
		exit 1
	fi

	# Check for a boring thumbnail
	COLORS=$(convert "$NEW" +dither -colors 5 -unique-colors txt: | wc -l)
	if [ $COLORS -lt 4 ] ; then
		# Pick a later image?
		if ! convert "$1"'[60]' -thumbnail x720 +profile "*" -flatten "$NEW" ; then
			rm -f "$NEW"
			exit 1
		fi
	fi

	mv "$NEW" "$THUMB"
fi
echo "$THUMB"
