#!/bin/bash
CACHE=~/.cache/playback/thumbnails
EXT=png
LOG=~/.cache/playback/thumbnailer.log

# Resolve this script's own path so cached thumbnails can be invalidated
# when the thumbnailer logic changes (e.g. the anamorphic filter fix).
# Handle all three invocation styles: absolute path, relative path, and
# bare name found on PATH. Falls back to $0 if resolution fails so the
# mtime test below simply never fires stale-detection.
SELF=$(command -v "$0" 2>/dev/null)
[ -n "$SELF" ] && [ -e "$SELF" ] || SELF="$0"

MEDIA=$(realpath "$@")

HASH=$(echo -n "$MEDIA" | sha256sum | awk '{print $1}')
INDEX=$(echo "$HASH" | cut -c-2)
mkdir -p "$CACHE"/$INDEX
NEW="$CACHE"/$INDEX/$HASH.new.$EXT
THUMB="$CACHE"/$INDEX/$HASH.$EXT
JSON="$THUMB.json"
RATINGS="$THUMB.ratings"
BASE_EXT=$(echo "$MEDIA" | awk -F. '{print $NF}')
if [ "$BASE_EXT" == "$MEDIA" ]; then
	# No extension, just give up.
	echo "$MEDIA: giving up, no extension" >> "$LOG"
	exit 1
fi
# TODO: create this safely
LINK="/tmp/thumbnailer-$$".$BASE_EXT

thumb_frame()
{
	local frame="$1"
	# Anamorphic-safe scale: first multiply the coded width by SAR (sample
	# aspect ratio) to convert to square-pixel display dimensions, then
	# scale to the 720-tall thumbnail target. Old AVI encodings (MPEG-4
	# ASP, MPEG-2, DV) often use non-square pixels; without the first
	# pass, a 720x480 NTSC 16:9 source would thumbnail to 1080x720 instead
	# of 1280x720 and look horizontally squashed. For square-pixel
	# sources, sar=1 and the first scale is a no-op.
	mpv "$LINK" --quiet --no-audio --sid=no --hwdec=no "--vf=lavfi=[scale=iw*sar:ih,scale=-1:720]" --start="$frame" --frames=1 --o="$NEW" >> "$LOG" 2>&1
}

do_thumbnail()
{
	ln -sf "$@" "$LINK"
	local frame

	# Scan for a few different frame positions
	for frame in 0 60 30 1 2 4 8 16; do
		if ! thumb_frame $frame ; then
			# Failed to get a frame -- try again
			continue
		fi

		# Check for a boring thumbnail (i.e. mostly the same color).
		# Standard deviation of pixel intensities (0..1) is a cleaner
		# signal than counting distinct colors — a near-black frame can
		# still have 8 "unique" values that differ by one per channel,
		# which the old -colors/-unique-colors check happily accepted.
		# Real content frames sit around 0.1+; studio logos/title cards
		# around 0.02-0.04; uniform frames near 0. awk does the float
		# compare since bash's [ can't.
		STDDEV=$(convert "$NEW" -format "%[fx:standard_deviation]" info:)
		if awk -v s="$STDDEV" 'BEGIN { exit !(s > 0.05) }' ; then
			break
		fi
	done


	# Take whatever we had at the last attempt, if possible.
	if [ -e "$NEW" ]; then
		echo "$@: using frame $frame" >> "$LOG"
	else
		echo "$@: gave up" >> "$LOG"
		# Failed to find anything. Don't try again in the future.
		convert -size 1280x720 xc:black "$NEW"
	fi
	mv "$NEW" "$THUMB"
	rm -f "$LINK"
}

do_json()
{
	ln -sf "$@" "$LINK"
	if mediainfo --Output=JSON "$LINK" > "$NEW".json 2>> "$LOG" ; then
		mv "$NEW".json "$JSON"
	fi
	rm -f "$LINK"
}

do_ratings()
{
	local media="$1"

	# Only look up ratings for files under a /Movies/ directory.
	echo "$media" | grep -q '/Movies/' || return 0

	# Require curl + jq; skip silently if missing.
	command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0

	# Extract title and year from a "Title Name (YYYY)" pattern. Try the
	# filename (sans extension) first, then the parent directory name.
	local name_noext
	name_noext=$(basename "$media")
	name_noext="${name_noext%.*}"

	local title="" year=""
	if [[ "$name_noext" =~ ^(.+)\ \(([0-9]{4})\)$ ]]; then
		title="${BASH_REMATCH[1]}"
		year="${BASH_REMATCH[2]}"
	else
		local dirname
		dirname=$(basename "$(dirname "$media")")
		if [[ "$dirname" =~ ^(.+)\ \(([0-9]{4})\)$ ]]; then
			title="${BASH_REMATCH[1]}"
			year="${BASH_REMATCH[2]}"
		else
			echo "$media: no 'Title (Year)' pattern found, skipping ratings" >> "$LOG"
			return 0
		fi
	fi

	echo "$media: looking up ratings for '$title' ($year)" >> "$LOG"

	# --- OMDb (Rotten Tomatoes + IMDb + Metacritic) ---
	local OMDB_KEY
	OMDB_KEY=$(grep ^omdb_apikey= ~/.config/Outflux/playback-walker.conf 2>/dev/null | cut -d= -f2-)

	local rt="" imdb="" metacritic="" plot="" omdb_title=""
	if [ -n "$OMDB_KEY" ]; then
		# Use the search endpoint (s=) rather than title lookup (t=)
		# so we can filter results ourselves. OMDb's t= does fuzzy
		# matching server-side and will return stub entries like
		# "Episode 6 - Terminator 2: Judgement Day (1991)" (a review-
		# show episode classified as Type=movie) for a "Terminator 2"
		# query — no way to override that from the client. s= returns
		# a list of candidates we can reject.
		local search_response
		search_response=$(curl -s -G "https://www.omdbapi.com/" \
			--data-urlencode "s=$title" \
			--data-urlencode "y=$year" \
			--data-urlencode "type=movie" \
			--data-urlencode "apikey=$OMDB_KEY")

		local search_ok best_id
		search_ok=$(echo "$search_response" | jq -r '.Response // "False"')
		if [ "$search_ok" = "True" ]; then
			# Pick the first result whose Title (case-insensitive,
			# transliterated) starts with our query title. Rejects
			# "Episode 6 - ..." stubs because they don't start with
			# the query. Falls through empty if nothing matches.
			local title_lc
			title_lc=$(echo "$title" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null | tr '[:upper:]' '[:lower:]')
			local match
			match=$(echo "$search_response" | jq -r --arg t "$title_lc" \
				'.Search // [] | map(select(.Title | ascii_downcase | startswith($t))) | .[0] // empty')
			if [ -n "$match" ]; then
				best_id=$(echo "$match" | jq -r '.imdbID')
				omdb_title=$(echo "$match" | jq -r '.Title')
				echo "$media: OMDb search matched '$omdb_title' ($best_id)" >> "$LOG"
			else
				echo "$media: OMDb search returned no title-prefix match" >> "$LOG"
			fi
		else
			echo "$media: OMDb search failed: $(echo "$search_response" | jq -r '.Error // "unknown"')" >> "$LOG"
		fi

		# Fetch full entry by IMDb ID for ratings + plot.
		if [ -n "$best_id" ]; then
			local omdb_response
			omdb_response=$(curl -s -G "https://www.omdbapi.com/" \
				--data-urlencode "i=$best_id" \
				--data-urlencode "plot=short" \
				--data-urlencode "apikey=$OMDB_KEY")

			if [ "$(echo "$omdb_response" | jq -r '.Response // "False"')" = "True" ]; then
				rt=$(echo "$omdb_response" | jq -r '(.Ratings // [])[] | select(.Source == "Rotten Tomatoes") | .Value // empty')
				imdb=$(echo "$omdb_response" | jq -r '(.Ratings // [])[] | select(.Source == "Internet Movie Database") | .Value // empty')
				metacritic=$(echo "$omdb_response" | jq -r '(.Ratings // [])[] | select(.Source == "Metacritic") | .Value // empty')
				# OMDb's short plot: 1-3 sentence factual description. "N/A"
				# is filtered to empty (OMDb returns literal "N/A" when the
				# field is unavailable).
				plot=$(echo "$omdb_response" | jq -r '.Plot // empty')
				[ "$plot" = "N/A" ] && plot=""
				echo "$media: OMDb: RT=$rt IMDb=$imdb Metacritic=$metacritic plot=${plot:+yes}" >> "$LOG"
			else
				echo "$media: OMDb i=$best_id fetch failed: $(echo "$omdb_response" | jq -r '.Error // "unknown"')" >> "$LOG"
			fi
		fi
	else
		echo "$media: no omdb_apikey configured, skipping OMDb" >> "$LOG"
	fi

	# --- Letterboxd (web scrape via og:title year check + JSON-LD rating) ---
	local letterboxd=""

	# Build a list of candidate titles to try. Letterboxd slugs
	# sometimes use the full title ("terminator-2-judgment-day") and
	# sometimes just the main part ("terminator-2"), so we try several
	# variants. OMDb's authoritative title (from the search match
	# above) is tried first when available — it's the most likely to
	# match Letterboxd's canonical slug. Then the filename's title,
	# then progressively shorter variants of that.
	local -a candidate_titles=()
	[ -n "$omdb_title" ] && [ "$omdb_title" != "$title" ] && candidate_titles+=("$omdb_title")
	candidate_titles+=("$title")
	local shortened
	shortened=$(echo "$title" | sed 's/ - .*//')
	[ "$shortened" != "$title" ] && candidate_titles+=("$shortened")
	shortened=$(echo "$title" | sed 's/:.*//')
	[ "$shortened" != "$title" ] && candidate_titles+=("$shortened")

	local tried_slugs=""
	local candidate slug lb_url lb_page lb_num
	for candidate in "${candidate_titles[@]}"; do
		# Build slug from candidate title. Transliterate accented
		# characters (é→e, ü→u, etc.) so "Amélie" produces "amelie" not
		# "am-lie". iconv's //TRANSLIT also normalises Unicode right-
		# single-quote (U+2019) to ASCII apostrophe. Apostrophes are
		# stripped before the general punctuation→hyphen pass —
		# Letterboxd drops them entirely rather than converting to a
		# hyphen, so "The Devil's Backbone" → "the-devils-backbone"
		# (not "the-devil-s-backbone", which 404s).
		slug=$(echo "$candidate" | iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null \
			| tr '[:upper:]' '[:lower:]' \
			| sed -e "s/'//g" -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')
		[ -n "$slug" ] || continue
		tried_slugs="$tried_slugs $slug"

		# For each candidate slug, try the bare form first then the
		# year-suffixed form (Letterboxd disambiguates title
		# collisions with a -YYYY suffix, e.g. /film/the-matrix-2025/).
		for lb_url in \
			"https://letterboxd.com/film/$slug/" \
			"https://letterboxd.com/film/$slug-$year/"; do

			lb_page=$(curl -s -L --fail "$lb_url" 2>/dev/null) || continue
			[ -n "$lb_page" ] || continue

			# Verify the year matches via the og:title meta tag:
			#   <meta property="og:title" content="The Matrix (1999)">
			echo "$lb_page" | grep -q 'property="og:title".*'"($year)" || continue

			# Extract the rating from the JSON-LD aggregateRating
			# block. More stable than HTML display elements since
			# the schema.org markup is part of their SEO and rarely
			# changes: "ratingValue":3.83
			lb_num=$(echo "$lb_page" | grep -o '"ratingValue":[0-9.]*' \
				| head -1 | sed 's/"ratingValue"://')
			if [ -n "$lb_num" ]; then
				letterboxd="$(printf '%g' "$lb_num")/5"
				echo "$media: Letterboxd ($lb_url): $letterboxd" >> "$LOG"
			fi
			break 2
		done
	done

	if [ -z "$letterboxd" ]; then
		echo "$media: Letterboxd lookup failed for slugs:$tried_slugs" >> "$LOG"
	fi

	# Only write the .ratings file if we got at least one rating or plot.
	if [ -n "$rt" ] || [ -n "$imdb" ] || [ -n "$metacritic" ] || [ -n "$letterboxd" ] || [ -n "$plot" ]; then
		jq -n \
			--arg title "$title" \
			--arg year "$year" \
			--arg rt "$rt" \
			--arg imdb "$imdb" \
			--arg metacritic "$metacritic" \
			--arg letterboxd "$letterboxd" \
			--arg plot "$plot" \
			'{title: $title, year: $year, rt: $rt, imdb: $imdb, metacritic: $metacritic, letterboxd: $letterboxd, plot: $plot}' \
			> "$NEW".ratings
		mv "$NEW".ratings "$RATINGS"
	else
		echo "$media: no ratings retrieved, skipping .ratings file" >> "$LOG"
	fi
}

if [ ! -e "$THUMB" ] || [ "$MEDIA" -nt "$THUMB" ] || [ "$SELF" -nt "$THUMB" ]; then
	do_thumbnail "$MEDIA"
else
	echo "$MEDIA: using thumb $THUMB" >> "$LOG"
fi

if [ ! -e "$JSON" ] || [ "$MEDIA" -nt "$JSON" ] || [ "$SELF" -nt "$JSON" ]; then
	do_json "$MEDIA"
else
	echo "$MEDIA: using json $JSON" >> "$LOG"
fi

if [ ! -e "$RATINGS" ] || [ "$MEDIA" -nt "$RATINGS" ] || [ "$SELF" -nt "$RATINGS" ]; then
	do_ratings "$MEDIA"
else
	echo "$MEDIA: using ratings $RATINGS" >> "$LOG"
fi

echo "$THUMB"
