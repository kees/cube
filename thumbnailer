#!/usr/bin/env python3
"""cube's thumbnailer: extract a representative frame, dump mediainfo
JSON, and — for /Movies/ files named "Title (YYYY).ext" — fetch ratings
and a plot blurb from OMDb and Letterboxd. Prints the cached thumbnail
path to stdout.

Cache layout under ~/.cache/playback/thumbnails/<aa>/<sha256>.{png,png.json,png.ratings},
keyed on the realpath of the media file. Each sidecar is mtime-checked
against the media and against this script, so updating the thumbnailer
logic (e.g. the anamorphic filter fix) automatically invalidates old
cached output on next run.

External tools needed: mpv (frame extraction), ImageMagick `convert`
(stddev check + fallback black placeholder), mediainfo (JSON dump).
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from contextlib import contextmanager
from pathlib import Path


HOME = Path.home()
CACHE    = HOME / ".cache" / "playback" / "thumbnails"
LOG_PATH = HOME / ".cache" / "playback" / "thumbnailer.log"
CONFIG   = HOME / ".config" / "Outflux" / "playback-walker.conf"

# Scan order for frame selection. Frame 0 is tried first since most
# films have a representative opening shot; the rest are fallback
# positions used when the earlier pick is too uniform to be useful.
FRAMES = [0, 60, 30, 1, 2, 4, 8, 16]

# Pixel-intensity standard deviation threshold (0..1). A uniformly
# coloured frame scores ~0, studio logos / title cards 0.02–0.04,
# real content frames 0.1+. Chosen to reject black frames and simple
# logos while keeping genuinely dim scenes.
STDDEV_THRESHOLD = 0.07

HTTP_TIMEOUT = 15
USER_AGENT = "Mozilla/5.0"

def log(msg):
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG_PATH, "a") as f:
        f.write(msg + "\n")


def is_stale(target, *sources):
    """True if `target` doesn't exist or any `source` is newer than it."""
    if not target.exists():
        return True
    tm = target.stat().st_mtime
    return any(s and os.path.exists(s) and os.path.getmtime(s) > tm
               for s in sources)


def normalize(s):
    """Lowercase + transliterate accents to ASCII + strip non-alphanumeric.
    Used for fuzzy OMDb title-prefix matching so punctuation drift
    (colons, apostrophes, hyphens) and spelling variants can still
    match — e.g. "My Little Pony The Movie" prefix-matches "My Little
    Pony: The Movie" because both collapse to "mylittleponythemovie"."""
    ascii_s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]", "", ascii_s.lower())


def slugify(s):
    """Letterboxd URL slug: lowercase, transliterate accents, strip
    apostrophes (Letterboxd drops them rather than hyphenating, so
    "The Devil's Backbone" → "the-devils-backbone"), then squash
    every run of non-alphanumerics to a single hyphen."""
    ascii_s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    stripped = ascii_s.lower().replace("'", "")
    hyphenated = re.sub(r"[^a-z0-9]+", "-", stripped)
    return hyphenated.strip("-")


def read_omdb_key():
    if not CONFIG.exists():
        return None
    for line in CONFIG.read_text().splitlines():
        if line.startswith("omdb_apikey="):
            return line.split("=", 1)[1].strip() or None
    return None


def http_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
        return json.loads(r.read().decode())


def http_text(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as r:
        return r.read().decode("utf-8", errors="replace")


def run_to_log(cmd):
    """Run `cmd` with stdout+stderr appended to the log file."""
    with open(LOG_PATH, "a") as logf:
        return subprocess.run(cmd, stdout=logf, stderr=logf)


def mpv_frame(link, new_path, frame):
    # Anamorphic-safe scale: multiply coded width by SAR first to
    # convert to square-pixel display dimensions, then scale to the
    # 720-tall thumbnail target. Without the first pass a 720x480 NTSC
    # 16:9 source would thumbnail to 1080x720 instead of 1280x720.
    return run_to_log([
        "mpv", str(link), "--quiet", "--no-audio", "--sid=no", "--hwdec=no",
        "--vf=lavfi=[scale=iw*sar:ih,scale=-1:720]",
        # update=1 silences ffmpeg's image2 muxer warning about
        # missing %d patterns — we're deliberately writing a single
        # image, not a sequence.
        "--ofopts-add=update=1",
        f"--start={frame}", "--frames=1", f"--o={new_path}",
    ]).returncode == 0


def stddev(path):
    try:
        r = subprocess.run(
            ["convert", str(path), "-format", "%[fx:standard_deviation]", "info:"],
            capture_output=True, text=True, check=True,
        )
        return float(r.stdout.strip())
    except (subprocess.CalledProcessError, ValueError):
        return None


@contextmanager
def link_to(target, ext):
    """Create a symlink to `target` inside a fresh temp directory,
    preserving the file extension (mpv sniffs format from the name).
    Yields the symlink path; removes the whole directory on exit. Uses
    tempfile.mkdtemp so the name is unique by OS guarantee rather than
    by $$ collision avoidance."""
    tmpdir = Path(tempfile.mkdtemp(prefix="thumbnailer-"))
    try:
        link = tmpdir / f"media.{ext}"
        link.symlink_to(target)
        yield link
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)


def do_thumbnail(media, new_path, thumb_path, ext):
    # mpv's --o picks the output encoder from the filename extension,
    # so we write to a ".png"-suffixed scratch sibling and rename on
    # success. Matches the same "new_path as stem" convention used
    # for .json / .ratings sidecars below.
    scratch = Path(f"{new_path}.png")
    with link_to(media, ext) as link:
        last_frame = None
        for frame in FRAMES:
            if not mpv_frame(link, scratch, frame):
                continue
            last_frame = frame
            sd = stddev(scratch)
            if sd is not None and sd > STDDEV_THRESHOLD:
                break

        if scratch.exists():
            log(f"{media}: using frame {last_frame}")
        else:
            log(f"{media}: gave up")
            # Couldn't extract any frame — write a black placeholder so
            # future runs don't retry forever.
            subprocess.run(
                ["convert", "-size", "1280x720", "xc:black", str(scratch)],
                check=False,
            )
        scratch.replace(thumb_path)


def do_json(media, new_path, json_path, ext):
    with link_to(media, ext) as link:
        new_json = Path(f"{new_path}.json")
        with open(LOG_PATH, "a") as logf, open(new_json, "wb") as out:
            r = subprocess.run(["mediainfo", "--Output=JSON", str(link)],
                               stdout=out, stderr=logf)
        if r.returncode == 0:
            new_json.replace(json_path)
        else:
            try:
                new_json.unlink()
            except FileNotFoundError:
                pass


TITLE_YEAR_RE = re.compile(r"^(.+) \((\d{4})\)$")


def parse_title_year(media):
    """Extract ("Title", "YYYY") from filename sans extension, falling
    back to parent directory name."""
    m = TITLE_YEAR_RE.match(Path(media).stem)
    if m:
        return m.group(1), m.group(2)
    m = TITLE_YEAR_RE.match(Path(media).parent.name)
    if m:
        return m.group(1), m.group(2)
    return None, None


def omdb_call(params):
    """Return the parsed JSON response, or a synthetic Response=False
    dict when the request fails (so callers can branch uniformly on
    .Response). OMDb returns HTTP 401 with a JSON body for both auth
    and rate-limit problems, distinguishable only by the .Error text
    ("Invalid API key!" vs "Request limit reached!") — so we try to
    parse the error body instead of just reporting the status code."""
    OMDB_URL = "https://www.omdbapi.com/"
    url = OMDB_URL + "?" + urllib.parse.urlencode(params)
    try:
        return http_json(url)
    except urllib.error.HTTPError as e:
        try:
            data = json.loads(e.read().decode())
            if isinstance(data, dict) and "Error" in data:
                return {"Response": "False",
                        "Error": f"HTTP {e.code}: {data['Error']}"}
        except Exception:
            pass
        return {"Response": "False", "Error": f"HTTP {e.code}"}
    except Exception as e:
        return {"Response": "False", "Error": str(e)}


def fetch_omdb(media, key, candidates, year):
    """Returns (rt, imdb, metacritic, plot, authoritative_title).
    All empty strings if nothing was found."""
    if not key:
        log(f"{media}: no omdb_apikey configured, skipping OMDb")
        return "", "", "", "", ""

    # Phase 1: find the right IMDb entry via search. OMDb's title
    # lookup (t=) does server-side fuzzy matching that sometimes
    # returns review-show episode stubs like "Episode 6 - Terminator
    # 2..." — search (s=) lets us filter client-side by title-prefix.
    best_id = ""
    omdb_title = ""
    for scand in candidates:
        r = omdb_call({"s": scand, "y": year, "type": "movie", "apikey": key})
        if r.get("Response") != "True":
            log(f"{media}: OMDb search '{scand}' failed: "
                f"{r.get('Error', 'unknown')}")
            continue
        cand_norm = normalize(scand)
        hit = next(
            (res for res in r.get("Search", [])
             if normalize(res.get("Title", "")).startswith(cand_norm)),
            None,
        )
        if hit:
            best_id = hit.get("imdbID", "")
            omdb_title = hit.get("Title", "")
            log(f"{media}: OMDb search '{scand}' matched '{omdb_title}' ({best_id})")
            break
        log(f"{media}: OMDb search '{scand}' returned no title-prefix match")

    if not best_id:
        return "", "", "", "", omdb_title

    # Phase 2: fetch full entry (ratings array + plot) by IMDb ID.
    data = omdb_call({"i": best_id, "plot": "short", "apikey": key})
    if data.get("Response") != "True":
        log(f"{media}: OMDb i={best_id} fetch failed: "
            f"{data.get('Error', 'unknown')}")
        return "", "", "", "", omdb_title

    ratings = {r.get("Source", ""): r.get("Value", "")
               for r in (data.get("Ratings") or [])}
    rt = ratings.get("Rotten Tomatoes", "")
    imdb = ratings.get("Internet Movie Database", "")
    metacritic = ratings.get("Metacritic", "")
    plot = data.get("Plot") or ""
    if plot == "N/A":
        plot = ""
    log(f"{media}: OMDb: RT={rt} IMDb={imdb} Metacritic={metacritic} "
        f"plot={'yes' if plot else ''}")
    return rt, imdb, metacritic, plot, omdb_title


def fetch_letterboxd(media, candidates, year):
    """Scrape Letterboxd's JSON-LD rating for the first candidate slug
    whose page exists and verifies the expected year."""
    tried = []
    for candidate in candidates:
        slug = slugify(candidate)
        if not slug:
            continue
        tried.append(slug)
        # Try the bare slug first, then the year-suffixed variant —
        # Letterboxd disambiguates title collisions with -YYYY
        # (e.g. /film/the-matrix-2025/).
        for url in (f"https://letterboxd.com/film/{slug}/",
                    f"https://letterboxd.com/film/{slug}-{year}/"):
            try:
                page = http_text(url)
            except Exception:
                continue
            if not page:
                continue
            # Verify the year via the og:title meta tag — e.g.
            # <meta property="og:title" content="The Matrix (1999)">.
            if not re.search(rf'property="og:title".*\({re.escape(year)}\)', page):
                continue
            # Rating comes from the JSON-LD aggregateRating block
            # (more stable than HTML display elements; the schema.org
            # markup is part of their SEO and rarely changes).
            m = re.search(r'"ratingValue":([0-9.]+)', page)
            if not m:
                return ""
            # printf '%g' behavior: strip trailing zeros, no scientific
            # notation for the 0..5 range we care about.
            letterboxd = f"{float(m.group(1)):g}/5"
            log(f"{media}: Letterboxd ({url}): {letterboxd}")
            return letterboxd
    log(f"{media}: Letterboxd lookup failed for slugs: " + " ".join(tried))
    return ""


def do_ratings(media, new_path, ratings_path):
    # Only look up ratings for files under a /Movies/ directory.
    if "/Movies/" not in media:
        return
    title, year = parse_title_year(media)
    if not title:
        log(f"{media}: no 'Title (Year)' pattern found, skipping ratings")
        return

    log(f"{media}: looking up ratings for '{title}' ({year})")

    # Candidate title variants, shared by OMDb search and Letterboxd
    # slugging: full title, then sub-title-stripped at " - ", then
    # at ":". Both services benefit from the fallbacks — OMDb's fuzzy
    # matcher misses British-vs-American spelling variants ("Judgement
    # Day" vs "Judgment Day"), and Letterboxd's canonical slugs
    # sometimes use just the main title.
    candidates = [title]
    for trimmed in (re.sub(r" - .*", "", title), re.sub(r":.*", "", title)):
        if trimmed != title and trimmed not in candidates:
            candidates.append(trimmed)

    key = read_omdb_key()
    rt, imdb, metacritic, plot, omdb_title = fetch_omdb(media, key, candidates, year)

    # Prepend OMDb's authoritative title as Letterboxd's first
    # candidate when available — it's the most likely to match
    # Letterboxd's canonical slug (e.g. "Terminator 2: Judgment Day"
    # → terminator-2-judgment-day).
    lb_candidates = candidates
    if omdb_title and omdb_title != candidates[0]:
        lb_candidates = [omdb_title] + candidates

    letterboxd = fetch_letterboxd(media, lb_candidates, year)

    if not any([rt, imdb, metacritic, letterboxd, plot]):
        log(f"{media}: no ratings retrieved, skipping .ratings file")
        return

    new_ratings = Path(f"{new_path}.ratings")
    with open(new_ratings, "w") as f:
        json.dump({
            "title": title, "year": year,
            "rt": rt, "imdb": imdb, "metacritic": metacritic,
            "letterboxd": letterboxd, "plot": plot,
        }, f, indent=2)
    new_ratings.replace(ratings_path)


def main():
    if len(sys.argv) < 2:
        print("usage: thumbnailer <media>", file=sys.stderr)
        sys.exit(1)

    media = os.path.realpath(sys.argv[1])

    # Bail on paths with no dot at all — we use the extension for the
    # /tmp symlink name so mpv can detect the container format.
    if "." not in media:
        log(f"{media}: giving up, no extension")
        sys.exit(1)
    base_ext = media.rsplit(".", 1)[-1]

    h = hashlib.sha256(media.encode()).hexdigest()
    index = h[:2]
    (CACHE / index).mkdir(parents=True, exist_ok=True)
    new_path = CACHE / index / f"{h}.new"
    thumb    = CACHE / index / f"{h}.png"
    json_sidecar = Path(f"{thumb}.json")
    ratings      = Path(f"{thumb}.ratings")
    self_path = os.path.abspath(__file__)

    if is_stale(thumb, media, self_path):
        do_thumbnail(media, new_path, thumb, base_ext)
    else:
        log(f"{media}: using thumb {thumb}")

    if is_stale(json_sidecar, media, self_path):
        do_json(media, new_path, json_sidecar, base_ext)
    else:
        log(f"{media}: using json {json_sidecar}")

    if is_stale(ratings, media, self_path):
        do_ratings(media, new_path, ratings)
    else:
        log(f"{media}: using ratings {ratings}")

    print(thumb)


if __name__ == "__main__":
    main()
